<div class="harkoniansvtt-window-content">

    <section class="harkoniansvtt-section">
        <h2>Account</h2>
        
        {{#if connected}}
            <div class="harkoniansvtt-connected">
                <p><strong>Connected as:</strong> {{account.username}}</p>
                <button type="button" data-action="testConnection" class="harkoniansvtt-button">
                    <i class="fas fa-check"></i> Test Connection
                </button>
                <button type="button" data-action="disconnect" class="harkoniansvtt-button harkoniansvtt-button-danger">
                    <i class="fas fa-unlink"></i> Disconnect
                </button>
            </div>
        {{else}}
            <p>Not connected to Harkonians.</p>
            <p>To connect, use the Harkonians button in the sidebar.</p>
        {{/if}}
    </section>

    <section class="harkoniansvtt-section">
        <h2>Character Linking</h2>
        
        {{#if hasCharacters}}
            <p>Select a character to link to your Harkonians account:</p>
            
            <div class="harkoniansvtt-character-list">
                {{#each characters}}
                    <label class="harkoniansvtt-character-entry {{#if isLinked}}harkoniansvtt-character-linked{{/if}}">
                        <input 
                            type="radio" 
                            name="harkonians-character" 
                            value="{{id}}"
                            data-actor-id="{{id}}"
                            {{#if isLinked}}disabled{{/if}}
                        />
                        <img src="{{img}}" alt="{{name}}" class="harkoniansvtt-character-img" />
                        <span class="harkoniansvtt-character-name">{{name}}</span>
                        
                        {{#if isLinked}}
                            <span class="harkoniansvtt-character-status">Already linked</span>
                        {{/if}}
                    </label>
                {{/each}}
            </div>
            
            <button type="button" data-action="linkCharacter" class="harkoniansvtt-button harkoniansvtt-button-primary">
                <i class="fas fa-link"></i> Link Character
            </button>
        {{else}}
            <p>No characters found. Create a character actor to link to Harkonians.</p>
        {{/if}}
    </section>

    <footer class="harkoniansvtt-footer">
        <button type="button" data-action="cancel" class="harkoniansvtt-button">
            Close
        </button>
    </footer>

</div>
