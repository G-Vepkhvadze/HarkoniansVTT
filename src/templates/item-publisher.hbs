<div class="harkonians-item-publisher-dialog">
    <section class="harkonians-item-summary">
        <img
                src="{{item.img}}"
                alt="{{item.name}}"
                class="harkonians-item-image"
        />

        <div>
            <h2>{{item.name}}</h2>
            <p>{{item.type}}</p>
        </div>
    </section>

    {{#if alreadyPublished}}
        <div class="harkonians-status harkonians-status-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>
        This Item is already linked to a Harkonians Store Item.
      </span>
        </div>
    {{else}}
        <form class="harkonians-publish-form">
            <div class="harkonians-form-row">
                <label for="harkonians-price-amount">
                    Price (GP)
                </label>

                <input
                        id="harkonians-price-amount"
                        name="priceAmount"
                        type="number"
                        min="0"
                        step="1"
                        value="1"
                        required
                />
            </div>

            <div class="harkonians-form-row">
                <label for="harkonians-stock">
                    Stock
                </label>

                <input
                        id="harkonians-stock"
                        name="stock"
                        type="number"
                        min="0"
                        step="1"
                        placeholder="Leave empty for unlimited"
                />

                <small>
                    Leave empty for unlimited stock.
                </small>
            </div>


            <div class="harkonians-actions">
                <button
                        type="button"
                        class="harkonians-button"
                        data-action="cancel"
                >
                    Cancel
                </button>

                <button
                        type="button"
                        class="harkonians-button harkonians-button-primary"
                        data-action="publishItem"
                >
                    <i class="fa-solid fa-store"></i>
                    Add to Harkonians
                </button>
            </div>
        </form>
    {{/if}}
</div>