<section class="harkonians-item-publisher">
    <header class="harkonians-item-publisher-header">
        <h1><i class="fa-solid fa-store"></i> Add Item to Harkonians</h1>
    </header>

    <div class="harkonians-item-search">
        <input 
            type="search" 
            name="itemSearch" 
            placeholder="Search Items..."
            value="{{searchQuery}}"
            class="harkonians-search-input"
            data-action="search"
        />
    </div>

    <div class="harkonians-item-list">
        {{#each items}}
            <button 
                type="button"
                data-action="selectItem"
                data-item-id="{{id}}"
                class="harkonians-item-entry {{#if alreadyPublished}}harkonians-item-published{{/if}}"
            >
                <img src="{{img}}" alt="" class="harkonians-item-icon" />
                <span class="harkonians-item-name">{{name}}</span>
                <small class="harkonians-item-type">{{type}}</small>
                {{#if alreadyPublished}}
                    <span class="harkonians-item-status"><i class="fa-solid fa-check"></i> Published</span>
                {{/if}}
            </button>
        {{/each}}
    </div>

    <footer class="harkonians-item-footer">
        {{#if selectedItem}}
            <div class="harkonians-selected-item">
                <h3>Selected: {{selectedItem.name}}</h3>
                
                <div class="harkonians-publish-form">
                    <div class="harkonians-form-group">
                        <label for="harkonians-price-amount">Store Price:</label>
                        <div class="harkonians-price-inputs">
                            <input 
                                type="number" 
                                id="harkonians-price-amount"
                                name="priceAmount"
                                value="{{priceAmount}}"
                                min="0"
                                step="1"
                                class="harkonians-input-number"
                            />
                            <select name="priceDenomination" class="harkonians-input-select">
                                <option value="pp" {{#if (eq priceDenomination "pp")}}selected{{/if}}>PP</option>
                                <option value="gp" {{#if (eq priceDenomination "gp")}}selected{{/if}}>GP</option>
                                <option value="ep" {{#if (eq priceDenomination "ep")}}selected{{/if}}>EP</option>
                                <option value="sp" {{#if (eq priceDenomination "sp")}}selected{{/if}}>SP</option>
                                <option value="cp" {{#if (eq priceDenomination "cp")}}selected{{/if}}>CP</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="harkonians-form-group">
                        <label>Stock:</label>
                        <div class="harkonians-stock-inputs">
                            <select name="stockValue" class="harkonians-input-select">
                                <option value="unlimited" {{#if (eq stockValue "unlimited")}}selected{{/if}}>Unlimited</option>
                                <option value="1" {{#if (eq stockValue 1)}}selected{{/if}}>1</option>
                                <option value="5" {{#if (eq stockValue 5)}}selected{{/if}}>5</option>
                                <option value="10" {{#if (eq stockValue 10)}}selected{{/if}}>10</option>
                                <option value="25" {{#if (eq stockValue 25)}}selected{{/if}}>25</option>
                                <option value="50" {{#if (eq stockValue 50)}}selected{{/if}}>50</option>
                                <option value="100" {{#if (eq stockValue 100)}}selected{{/if}}>100</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        {{else}}
            <span class="harkonians-no-selection">Select an Item</span>
        {{/if}}

        <button 
            type="button" 
            data-action="publishItem"
            class="harkonians-button harkonians-button-primary harkonians-publish-button"
            {{#if isPublishDisabled}}disabled{{/if}}
        >
            <i class="fa-solid fa-paper-plane"></i> {{publishButtonLabel}}
        </button>
    </footer>
</section>
