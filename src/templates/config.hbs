<form class="harkonians-config">
  <header class="flex-header">
    <h1 class="grow-header">{{localize "HARKONIANS.configTitle"}}</h1>
  </header>
  
  <section class="settings-section">
    <label for="apiKey">{{localize "HARKONIANS.apiKeyLabel"}}</label>
    <input 
      type="text" 
      id="apiKey" 
      name="apiKey" 
      value="{{apiKey}}"
      placeholder="{{localize 'HARKONIANS.apiKeyPlaceholder'}}"
      class="config-input"
    />
    <p class="hint">{{localize "HARKONIANS.apiKeyHint"}}</p>
  </section>
  
  <footer class="flex-footer">
    <button type="submit" class="submit-button">{{localize "HARKONIANS.saveButton"}}</button>
  </footer>
</form>
