<form class="harkonians-publish-form">
  <header class="flex-header">
    <h1 class="grow-header">
      {{#if isUpdate}}
        {{localize "HARKONIANS.updateStoreItem"}}
      {{else}}
        {{localize "HARKONIANS.publishToStore"}}
      {{/if}}
    </h1>
    <button class="close-button" type="button">
      <i class="fas fa-times"></i>
    </button>
  </header>

  {{!-- ITEM INFORMATION (READ-ONLY) --}}
  <section class="item-info-section">
    <h2>{{localize "HARKONIANS.itemInformation"}}</h2>
    
    <div class="item-preview">
      {{#if itemImg}}
        <img src="{{itemImg}}" alt="{{itemName}}" class="item-preview-img" />
      {{else}}
        <div class="item-preview-placeholder">
          <i class="fas fa-box"></i>
        </div>
      {{/if}}
      
      <div class="item-preview-details">
        <div class="item-preview-field">
          <label>{{localize "HARKONIANS.name"}}</label>
          <span>{{itemName}}</span>
        </div>
        
        <div class="item-preview-field">
          <label>{{localize "HARKONIANS.type"}}</label>
          <span>{{itemType}}</span>
        </div>
        
        {{#if itemDescription}}
          <div class="item-preview-field description">
            <label>{{localize "HARKONIANS.description"}}</label>
            <span>{{itemDescription}}</span>
          </div>
        {{/if}}
      </div>
    </div>
    
    <p class="hint">{{localize "HARKONIANS.itemDataWillBePreserved"}}</p>
  </section>

  {{!-- STORE METADATA (EDITABLE) --}}
  <section class="store-metadata-section">
    <h2>{{localize "HARKONIANS.storeMetadata"}}</h2>
    
    <div class="form-group">
      <label for="price">{{localize "HARKONIANS.price"}} *</label>
      <div class="input-with-addon">
        <input 
          type="number" 
          id="price" 
          name="price" 
          class="form-input"
          min="0"
          step="0.01"
          value="1"
          required
        />
        <select id="denomination" name="denomination" class="form-select">
          <option value="cp">{{localize "HARKONIANS.cp"}}</option>
          <option value="sp">{{localize "HARKONIANS.sp"}}</option>
          <option value="ep">{{localize "HARKONIANS.ep"}}</option>
          <option value="gp" selected>{{localize "HARKONIANS.gp"}}</option>
          <option value="pp">{{localize "HARKONIANS.pp"}}</option>
        </select>
      </div>
      <p class="hint">{{localize "HARKONIANS.priceHint"}}</p>
    </div>
    
    <div class="form-group">
      <label>{{localize "HARKONIANS.stock"}} *</label>
      <div class="stock-options">
        <label class="checkbox-label">
          <input type="checkbox" id="stock-unlimited" name="stock-unlimited" checked />
          <span>{{localize "HARKONIANS.unlimited"}}</span>
        </label>
        <div class="limited-stock">
          <input 
            type="number" 
            id="stock-quantity" 
            name="stock-quantity" 
            class="form-input"
            min="1"
            value="1"
          />
        </div>
      </div>
      <p class="hint">{{localize "HARKONIANS.stockHint"}}</p>
    </div>
    
    <div class="form-group">
      <label for="store-description">{{localize "HARKONIANS.storeDescriptionOverride"}}</label>
      <textarea 
        id="store-description" 
        name="store-description" 
        class="form-textarea"
        rows="3"
        placeholder="{{localize 'HARKONIANS.storeDescriptionPlaceholder'}}"
      ></textarea>
      <p class="hint">{{localize "HARKONIANS.storeDescriptionHint"}}</p>
    </div>
    
    <div class="form-group">
      <label for="store-image">{{localize "HARKONIANS.storeImageOverride"}}</label>
      <input 
        type="url" 
        id="store-image" 
        name="store-image" 
        class="form-input"
        placeholder="https://..."
      />
      <p class="hint">{{localize "HARKONIANS.storeImageHint"}}</p>
    </div>
  </section>

  <footer class="dialog-footer">
    <button type="button" class="btn-danger" data-action="cancel">
      <i class="fas fa-times"></i> {{localize "HARKONIANS.cancel"}}
    </button>
    <button type="submit" class="btn-success">
      <i class="fas fa-upload"></i>
      {{#if isUpdate}}
        {{localize "HARKONIANS.updateItem"}}
      {{else}}
        {{localize "HARKONIANS.publishItem"}}
      {{/if}}
    </button>
  </footer>
</form>
