<section class="harkonians-manager">
    <header class="harkonians-manager-header">
        <h1><i class="fa-solid fa-store"></i> Harkonians</h1>
    </header>

    <div class="harkonians-manager-section">
        <h2>WORLD</h2>
        <div class="harkonians-world-status">
            <p><strong>World:</strong> {{world.name}}</p>
            <p><strong>Status:</strong> 
                {{#if worldLinked}}
                    <span class="harkonians-status-connected"><i class="fa-solid fa-check"></i> Connected</span>
                {{else}}
                    <span class="harkonians-status-disconnected">Not Connected</span>
                {{/if}}
            </p>
            {{#if worldLinked}}
                <button type="button" data-action="pairWorld" class="harkonians-button">
                    <i class="fa-solid fa-link-slash"></i> Reconnect World
                </button>
            {{else}}
                <button type="button" data-action="pairWorld" class="harkonians-button harkonians-button-primary">
                    <i class="fa-solid fa-link"></i> Pair World
                </button>
            {{/if}}
        </div>
    </div>

    {{#if worldLinked}}
        <div class="harkonians-manager-section">
            <h2>CHARACTERS</h2>
            {{#if characters}}
                <div class="harkonians-character-list">
                    {{#each characters}}
                        <div class="harkonians-character-entry" data-actor-id="{{actorId}}">
                            <div class="harkonians-character-info">
                                <span class="harkonians-character-name">{{name}}</span>
                                {{#if linked}}
                                    <span class="harkonians-character-linked">
                                        {{#if harkoniansName}}
                                            <strong>Harkonians:</strong> {{harkoniansName}}
                                        {{/if}}
                                        {{#if creditBalance}}
                                            <br><strong>Balance:</strong> {{creditBalance}} CP
                                        {{/if}}
                                    </span>
                                    <button type="button" data-action="refresh" class="harkonians-button harkonians-button-small">
                                        <i class="fa-solid fa-sync"></i> Refresh
                                    </button>
                                    <button type="button" data-action="unlinkActor" class="harkonians-button harkonians-button-small harkonians-button-danger">
                                        <i class="fa-solid fa-unlink"></i> Unlink
                                    </button>
                                {{else}}
                                    <span class="harkonians-character-not-linked">Not Connected</span>
                                    <button type="button" data-action="linkActor" class="harkonians-button harkonians-button-primary harkonians-button-small">
                                        <i class="fa-solid fa-link"></i> Link
                                    </button>
                                {{/if}}
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <p class="harkonians-no-characters">No characters found. Create a character first.</p>
            {{/if}}
        </div>
    {{else}}
        <div class="harkonians-manager-section harkonians-disabled">
            <h2>CHARACTERS</h2>
            <p>Pair the world first to link characters.</p>
        </div>
    {{/if}}
</section>
