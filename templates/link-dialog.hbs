<div class="harkonians-link-dialog">
    <section class="harkonians-section">
        <header class="harkonians-section-header">
            <h2>
                <i class="fa-solid fa-globe"></i>
                World Link
            </h2>
        </header>

        {{#if worldLinked}}
            <div class="harkonians-status harkonians-status-success">
                <i class="fa-solid fa-circle-check"></i>
                <span>This Foundry world is linked to Harkonians.</span>
            </div>

            {{#if isGM}}
                <p class="harkonians-help">
                    Entering a new pairing code will replace the current
                    world link.
                </p>

                <div class="harkonians-form-row">
                    <label for="harkonians-pairing-code">
                        Pairing Code
                    </label>

                    <input
                            id="harkonians-pairing-code"
                            name="pairingCode"
                            type="text"
                            autocomplete="off"
                            placeholder="Enter pairing code"
                    />

                    <button
                            type="button"
                            class="harkonians-button"
                            data-action="linkWorld"
                    >
                        <i class="fa-solid fa-link"></i>
                        Relink World
                    </button>
                </div>
            {{/if}}
        {{else}}
            {{#if isGM}}
                <p class="harkonians-help">
                    Enter the world pairing code generated by Harkonians
                    to connect this Foundry world.
                </p>

                <div class="harkonians-form-row">
                    <label for="harkonians-pairing-code">
                        Pairing Code
                    </label>

                    <input
                            id="harkonians-pairing-code"
                            name="pairingCode"
                            type="text"
                            autocomplete="off"
                            placeholder="Enter pairing code"
                    />

                    <button
                            type="button"
                            class="harkonians-button harkonians-button-primary"
                            data-action="linkWorld"
                    >
                        <i class="fa-solid fa-link"></i>
                        Link World
                    </button>
                </div>
            {{else}}
                <div class="harkonians-status harkonians-status-warning">
                    <i class="fa-solid fa-link-slash"></i>
                    <span>
            This world has not been linked yet.
            Ask the GM to link it to Harkonians.
          </span>
                </div>
            {{/if}}
        {{/if}}
    </section>

    <section class="harkonians-section">
        <header class="harkonians-section-header">
            <h2>
                <i class="fa-solid fa-user"></i>
                Actor Link
            </h2>
        </header>

        {{#if worldLinked}}
            {{#if linkedActor}}
                <div class="harkonians-status harkonians-status-success">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>
            Currently linked:
            <strong>{{linkedActor.name}}</strong>
          </span>
                </div>
            {{/if}}

            {{#if ownedActors.length}}
                <div class="harkonians-form-row">
                    <label for="harkonians-actor">
                        Actor
                    </label>

                    <select
                            id="harkonians-actor"
                            name="actorId"
                    >
                        {{#each ownedActors}}
                            <option
                                    value="{{id}}"
                                    {{#if selected}}selected{{/if}}
                            >
                                {{name}}
                            </option>
                        {{/each}}
                    </select>

                    <button
                            type="button"
                            class="harkonians-button harkonians-button-primary"
                            data-action="linkActor"
                    >
                        <i class="fa-solid fa-user-link"></i>
                        Link Actor
                    </button>
                </div>
            {{else}}
                <div class="harkonians-status harkonians-status-warning">
                    <i class="fa-solid fa-user-slash"></i>
                    <span>
            You do not currently own any Actors that can be linked.
          </span>
                </div>
            {{/if}}
        {{else}}
            <div class="harkonians-status harkonians-status-disabled">
                <i class="fa-solid fa-lock"></i>
                <span>
          Link the Foundry world before linking an Actor.
        </span>
            </div>
        {{/if}}
    </section>
</div>